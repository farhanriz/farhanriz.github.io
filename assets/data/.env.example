# Google Sheets API Configuration
# Get these values from Google Cloud Console

# Service account JSON file path (download from Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Google Sheets Spreadsheet ID (from the spreadsheet URL)
# Example: https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here